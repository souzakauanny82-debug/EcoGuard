# =====================================================================
# EcoGuard - Arquivo de Configuração de Exemplo (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente:
# cp .env.example .env
# =====================================================================

# Porta onde o servidor Express irá rodar
PORT=3000

# Ambiente de execução: development, test ou production
NODE_ENV=development

# Caminho do arquivo do banco de dados SQLite local
DB_PATH=./ecoguard.db

# Segredo para assinatura de sessões e integridade de tokens (fictício para exemplo)
SESSION_SECRET=exemplo_segredo_super_seguro_ecoguard_ifro_2026
